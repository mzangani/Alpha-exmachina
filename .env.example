# ============================================================
#  MicroGarden — configurazione ambiente
#  Copia questo file in `.env` (cp .env.example .env) e compila.
#  Il file .env è nel .gitignore: NON verrà mai committato.
# ============================================================

# La tua chiave API di Anthropic.
# Si ottiene da https://platform.claude.com -> API Keys -> Create Key.
# Serve SOLO se MOCK_MODE=false: in mock mode puoi lasciarla vuota.
ANTHROPIC_API_KEY=

# Il modello Claude usato dagli agenti AI.
# claude-sonnet-4-6 è un buon compromesso qualità/costo per questo MVP.
MODEL_NAME=claude-sonnet-4-6

# true  = gli agenti NON chiamano l'API e rispondono con dati finti
#         letti da tests/fixtures/*.json (sviluppo e test GRATIS).
# false = gli agenti chiamano davvero l'API di Anthropic (a pagamento).
MOCK_MODE=true

# Percorso del database SQLite (viene creato al primo avvio).
DATABASE_URL=sqlite:///./microgarden.db
